generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres (Supabase/Neon em produção; Postgres embutido localmente — ver
  // scripts/local-pg.ts e src/tests/global-setup.ts). SQLite foi aposentado:
  // migrations antigas em prisma/migrations-sqlite/.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  // Nulo para contas criadas via login do Google (sem senha local).
  passwordHash String?
  // "sub" do Google do usuário; nulo para contas de email/senha.
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  rounds       Round[]
  scores       Score[]
}

model Car {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  brand     String
  /// Designação precisa do modelo/geração (ex.: "Skyline GT-R (R34)").
  model     String
  category  String
  /// Anos de produção da geração retratada.
  years     String
  /// Bytes da imagem (JPEG/PNG, lado maior ≤1280px) — o jogo NÃO depende de
  /// host externo em runtime; a imagem é servida por /api/cars/:id/image.
  imageData Bytes
  imageMime String   @default("image/jpeg")
  /// Proveniência/atribuição (Wikimedia Commons) — compliance de licença.
  sourceUrl   String
  filePageUrl String
  author      String
  license     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  rounds    Round[]
}

/// Estado de uma rodada. O nome do carro nunca sai do servidor antes do fim
/// (status != playing) — anti-cheat.
model Round {
  id              Int      @id @default(autoincrement())
  userId          Int?
  user            User?    @relation(fields: [userId], references: [id])
  carId           Int
  car             Car      @relation(fields: [carId], references: [id])
  mode            String
  status          String   @default("playing")
  attemptsUsed    Int      @default(0)
  revealedLetters String   @default("[]")
  dailyDate       String?
  points          Int?
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  scores          Score[]

  @@unique([userId, dailyDate])
  @@index([userId, status])
  @@index([status])
  @@index([mode])
}

/// Pontos registrados no ranking — apenas de usuários autenticados.
model Score {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  roundId   Int?
  round     Round?   @relation(fields: [roundId], references: [id])
  points    Int
  mode      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([mode])
  /// Guarda dupla contra race de acertos paralelos: no máximo UM score
  /// por rodada, mesmo sob requisições simultâneas.
  @@unique([roundId])
}
