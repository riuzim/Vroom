generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres (Supabase/Neon em produção; Postgres embutido localmente — ver
  // scripts/local-pg.ts e src/tests/global-setup.ts). SQLite foi aposentado:
  // migrations antigas em prisma/migrations-sqlite/.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  // Nulo para contas criadas via login do Google (sem senha local).
  passwordHash String?
  // "sub" do Google do usuário; nulo para contas de email/senha.
  googleId     String?  @unique
  // Última vez que o admin abriu a caixa de entrada de feedback —
  // feedbacks criados depois disso tocam o "sino" de feedback novo.
  feedbackSeenAt DateTime?
  createdAt    DateTime @default(now())
  rounds       Round[]
  scores       Score[]
  feedback     Feedback[]
}

model Car {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  brand     String
  /// Designação precisa do modelo/geração (ex.: "Skyline GT-R (R34)").
  model     String
  category  String
  /// Anos de produção da geração retratada.
  years     String
  /// Bytes da imagem (JPEG/PNG, lado maior ≤1280px) — o jogo NÃO depende de
  /// host externo em runtime; a imagem sai pela rodada (/api/rounds/:id/image).
  imageData Bytes
  imageMime String   @default("image/jpeg")
  /// Proveniência/atribuição (Wikimedia Commons) — compliance de licença.
  sourceUrl   String
  filePageUrl String
  author      String
  license     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  rounds    Round[]
  dailyCars DailyCar[]
}

/// Estado de uma rodada. O nome do carro nunca sai do servidor antes do fim
/// (status != playing) — anti-cheat.
model Round {
  id              Int      @id @default(autoincrement())
  userId          Int?
  user            User?    @relation(fields: [userId], references: [id])
  carId           Int
  car             Car      @relation(fields: [carId], references: [id])
  mode            String
  status          String   @default("playing")
  attemptsUsed    Int      @default(0)
  revealedLetters String   @default("[]")
  dailyDate       String?
  /// Sessão de visitante (cookie vroom_guest) que criou esta rodada —
  /// sem isso qualquer visitante encerraria rodadas alheias por id.
  guestSessionId  String?
  points          Int?
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  scores          Score[]

  @@unique([userId, dailyDate])
  @@index([userId, status])
  @@index([status])
  @@index([mode])
  // Sorteio sem repetição varre rodadas recentes por sessão de visitante.
  @@index([guestSessionId])
}

/// Pontos registrados no ranking — apenas de usuários autenticados.
model Score {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  roundId   Int?
  round     Round?   @relation(fields: [roundId], references: [id])
  points    Int
  mode      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([mode])
  /// Guarda dupla contra race de acertos paralelos: no máximo UM score
  /// por rodada, mesmo sob requisições simultâneas.
  @@unique([roundId])
}

/// Carro oficial de cada desafio do dia (por modo). Escrito UMA vez por
/// dia/modo no primeiro início de rodada — congela a escolha mesmo se o
/// catálogo mudar no meio do dia e deixa o ARCHIVE pronto: dias passados
/// podem ser rejogados consultando esta tabela, sem recomputar índices.
/// Para o modo themed, `date` guarda "YYYY-MM-DD#tema".
model DailyCar {
  id     Int @id @default(autoincrement())
  date   String
  mode   String
  carId  Int
  car    Car @relation(fields: [carId], references: [id])

  @@unique([date, mode])
}

/// Feedback enviado pela página /feedback — opinião, bug ou sugestão.
/// Print é opcional (Bytes); autor é nulo para visitantes. O painel admin
/// lista por categoria e "marcar como lido" = excluir.
model Feedback {
  id        Int      @id @default(autoincrement())
  authorId  Int?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category  String
  title     String
  content   String
  /// Print anexado quando category = bug (PNG/JPEG/WebP, ≤ 2 MB).
  imageData Bytes?
  imageMime String?
  createdAt DateTime @default(now())

  @@index([category, createdAt])
}
