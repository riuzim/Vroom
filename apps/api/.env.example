# Prisma — caminho do banco SQLite
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os JWTs de sessão (cookie httpOnly).
# Em produção (NODE_ENV=production) exige 32+ caracteres e recusa valores de exemplo.
# Gere um forte com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="dev-secret-troque-em-producao"

PORT=4000

# Origens CORS autorizadas (separadas por vírgula, SEM barra final).
# Em produção inclua o front do GitHub Pages, ex.: "https://riuzim.github.io"
CORS_ORIGIN="http://localhost:5173,http://localhost:4173"

# Quantos hops de proxy reverso existem na frente da API (Express `trust proxy`).
# Em produção atrás de nginx/Cloudflare use '1' (ou o nº de hops) para o
# rate-limit enxergar o IP real do cliente. Vazio em dev local.
TRUST_PROXY=""

# Client ID OAuth do Google (Google Cloud Console → Credentials → OAuth Client ID,
# tipo "Web application"). É a audience validada no verifyIdToken.
# Sem ele, POST /api/auth/google responde 503 e o botão não renderiza no front.
GOOGLE_CLIENT_ID=""
