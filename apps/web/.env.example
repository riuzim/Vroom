# Origem pública da API em produção (sem barra final), ex.: "https://api.vroom.example"
# Vazio em dev: o proxy do Vite encaminha /api → localhost:4000.
VITE_API_URL=""

# OAuth Client ID do Google (MESMO valor do GOOGLE_CLIENT_ID da API).
# Authorized JavaScript origins no Google Cloud Console:
#   http://localhost:5173 (dev) e https://<usuario>.github.io (produção)
VITE_GOOGLE_CLIENT_ID=""
