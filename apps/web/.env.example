# Origem pública da API em produção (sem barra final), ex.: "https://api.vroom.example"
# Vazio em dev: o proxy do Vite encaminha /api → localhost:4000.
VITE_API_URL=""

# OAuth Client ID do Google (MESMO valor do GOOGLE_CLIENT_ID da API).
# Authorized JavaScript origins no Google Cloud Console:
#   http://localhost:5173 (dev) e https://<usuario>.github.io (produção)
VITE_GOOGLE_CLIENT_ID=""

# ------------------------------------------------------------------
# Deploy em servidor/domínio próprio + monetização AdSense (opcional)
# ------------------------------------------------------------------

# Base pública do build. VAZIO mantém '/Vroom/' (GitHub Pages atual).
# Com domínio próprio servindo na raiz, use VITE_BASE="/".
VITE_BASE=""

# URL pública do site SEM barra final (ex.: "https://vroom.example.com").
# Quando definida, o build gera robots.txt e sitemap.xml no dist.
VITE_SITE_URL=""

# ID do editor do AdSense (AdSense → Contas → "ca-pub-0000000000000000").
# Quando definido: habilita os AdSlots, libera os domínios do Google na CSP
# e gera ads.txt no dist. Só preencha depois da conta APROVADA.
VITE_ADSENSE_CLIENT=""
